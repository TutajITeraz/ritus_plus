# Reference unit for the Ritus server. Copy to /etc/systemd/system/kraken_flask.service,
# adjust User/WorkingDirectory/ExecStart to match the box, then:
#
#     systemctl daemon-reload && systemctl restart kraken_flask
#
# Two settings here exist because of a real outage: a batch transcription
# over-committed RAM, the kernel OOM killer took a gunicorn process, and the
# whole unit went down and stayed down ("Failed with result 'oom-kill'") in
# the middle of a run. OOMPolicy and Restart together mean the service comes
# back by itself; the server then reconciles the job rows it left behind and
# each project offers Resume / Retry.

[Unit]
Description=Gunicorn instance to serve Kraken Flask
After=network.target

[Service]
User=ispan
Group=ispan
WorkingDirectory=/home/ispan/domains/ritus-indexer.ispan.pl/ritus-server
Environment="PATH=/home/ispan/domains/ritus-indexer.ispan.pl/ritus-server/.venv/bin"

# -w 1 is mandatory, not a tuning choice: the registries that track which
# project is downloading or transcribing live in this process's memory, so a
# second worker would answer Cancel requests for jobs it has never heard of.
# Concurrency comes from --threads, and from the transcription worker pool
# inside the process (see transcription_workers in domain_config.json).
# The timeout is generous because a single page can legitimately occupy a
# thread for minutes; the default 30s would shoot the worker for being slow.
ExecStart=/home/ispan/domains/ritus-indexer.ispan.pl/ritus-server/.venv/bin/gunicorn \
    --workers 1 \
    --threads 8 \
    --timeout 600 \
    --bind 127.0.0.1:5000 \
    krakenServer:app

# Do not stop the unit because one of its processes was OOM-killed - restart it.
OOMPolicy=continue
Restart=always
RestartSec=10

# Make this service the cgroup the kernel measures, so an over-commit here
# cannot take down Ollama or the rest of the box. The server reads this limit
# (cgroup memory.max) and sizes its transcription workers against it, so raising
# or lowering it retunes transcription automatically - no config change needed.
#
# Pick a value that leaves room for everything else: on a 31 GB box where
# Ollama holds ~20 GB, 8G is about right. MemoryHigh throttles before
# MemoryMax kills, which usually turns a would-be OOM into slow progress.
MemoryHigh=7G
MemoryMax=8G

[Install]
WantedBy=multi-user.target
